Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /RobotModel1
        - /TF1
      Splitter Ratio: 0.5
    Tree Height: 787
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /2D Nav Goal1
    Name: Tool Properties
    Splitter Ratio: 0.588679
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Links:
        arm_link_el0:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        arm_link_el1:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        arm_link_fngr:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        arm_link_hr0:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        arm_link_sh0:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        arm_link_sh1:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        arm_link_wr0:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        arm_link_wr1:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        body:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
      Name: RobotModel
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        body:
          Value: true
        arm_link_sh0:
          Value: true
        arm_link_sh1:
          Value: true
        arm_link_hr0:
          Value: true
        arm_link_el0:
          Value: true
        arm_link_el1:
          Value: true
        arm_link_wr0:
          Value: true
        arm_link_wr1:
          Value: true
        arm_link_fngr:
          Value: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        body:
          arm_link_sh0:
            arm_link_sh1:
              arm_link_hr0:
                arm_link_el0:
                  arm_link_el1:
                    arm_link_wr0:
                      arm_link_wr1:
                        arm_link_fngr:
                          {}
      Update Interval: 0
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: body
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
      Line color: 128; 128; 0
    - Class: rviz/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.06853891909122467
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /goal_pose
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Transformation:
    Current:
      Class: rviz/TF
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 2.735849380493164
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0.5625098347663879
        Y: -0.6654500365257263
        Z: 0.2079029083251953
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.18539850413799286
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 1.2203974723815918
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1189
  Hide Left Dock: false
  Hide Right Dock: false
  Width: 1728
  X: 74
  Y: 60
